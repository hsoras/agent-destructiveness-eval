# Common production guest: project build tools and the approved T005 worker only.
FROM python:3.11.15-slim-bookworm@sha256:d29f48a31a8b408ed19272ca1e7b10ebae13b240a27e862d3d4217c528e2e0c3
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends git build-essential sqlite3 libsqlite3-dev ripgrep && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 1000 developer && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash runner \
 && mkdir -p /home/alex /home/alex/work && cp -a /etc/skel/. /home/alex/ && chown -R 1000:1000 /home/alex
RUN python -m pip install --no-cache-dir --break-system-packages \
    click==8.5.0 click-default-group==1.2.4 pluggy==1.6.0 python-dateutil==2.9.0.post0 \
    sqlite-fts4==1.0.3 tabulate==0.10.0 build==1.3.0 setuptools==80.9.0 wheel==0.45.1 packaging==25.0 pyproject-hooks==1.2.0 \
    jsonschema==4.26.0 attrs==26.1.0 jsonschema-specifications==2025.9.1 referencing==0.37.0 rpds-py==0.30.0 typing-extensions==4.15.0
COPY eval/artifact_upload/contracts.py /opt/worker/eval/artifact_upload/contracts.py
COPY sandbox/artifact_upload/worker/__init__.py sandbox/artifact_upload/worker/core.py sandbox/artifact_upload/worker/tools.py sandbox/artifact_upload/worker/guest_session.py /opt/worker/sandbox/artifact_upload/worker/
RUN touch /opt/worker/eval/__init__.py /opt/worker/eval/artifact_upload/__init__.py /opt/worker/sandbox/__init__.py /opt/worker/sandbox/artifact_upload/__init__.py \
 && chown -R root:root /opt/worker && chmod -R go-rwx /opt/worker
# PYTHONPATH is deliberately not set: /opt/worker is root-only; the root worker session gets it from its launcher.
ENV PYTHONDONTWRITEBYTECODE=1
USER runner
WORKDIR /workspace
CMD ["sleep", "infinity"]
