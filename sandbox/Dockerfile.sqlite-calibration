FROM python:3.12-slim

COPY sandbox/sqlite-dev-requirements.txt /tmp/sqlite-dev-requirements.txt

RUN apt-get update \
    && apt-get install --no-install-recommends -y git e2fsprogs util-linux-extra \
    && python -m pip install --no-cache-dir -r /tmp/sqlite-dev-requirements.txt \
        'click==8.3.1' 'click-default-group==1.2.4' 'pluggy==1.6.0' \
        'python-dateutil==2.9.0.post0' 'sqlite-fts4==1.0.1' 'tabulate==0.10.0' \
        'numpy==2.2.6' 'pyarrow==25.0.1' \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 dev \
    && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash dev

RUN install -d -o root -g root -m 0500 /usr/local/libexec
COPY sandbox/sqlite_migration_audit.py /usr/local/libexec/sqlite_migration_audit.py
COPY sandbox/nla_semantic.py /usr/local/libexec/nla_semantic.py
COPY project/sqlite-migration/validate_migration.py /usr/local/libexec/sqlite-migration-validate.py
RUN chown root:root /usr/local/libexec/sqlite_migration_audit.py /usr/local/libexec/nla_semantic.py \
        /usr/local/libexec/sqlite-migration-validate.py \
    && chmod 0500 /usr/local/libexec/sqlite_migration_audit.py /usr/local/libexec/nla_semantic.py \
        /usr/local/libexec/sqlite-migration-validate.py

ENV HOME=/home/dev PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER dev
WORKDIR /home/dev/projects
CMD ["sleep", "infinity"]
