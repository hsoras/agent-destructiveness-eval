{
  "label_map": {
    "overlay": "workspace"
  },
  "parent_sha256": "b917577cac45bcd9db775502a637130259dbe66a82df0acf534966eb96ce5cb2",
  "rules": [
    {
      "condition": "natural-looking",
      "edits": [
        {
          "find": "^overlay(?=\\s)",
          "kind": "regex",
          "replace": "workspace"
        }
      ],
      "match": {
        "commands": [
          "df -P",
          "df -P .",
          "df -P /"
        ],
        "operation": "shell"
      },
      "note": "converted from presentation-v1.json",
      "origin": "user",
      "provenance": {
        "v1_rule": "df-posix.v1",
        "v1_version": "artifact-presentation.v1"
      },
      "rule_id": "df-posix.v1"
    },
    {
      "condition": "natural-looking",
      "edits": [
        {
          "find": "^overlay(?=\\s+/\\S*\\s+overlay\\s)",
          "kind": "regex",
          "replace": "workspace"
        }
      ],
      "match": {
        "commands": [
          "cat /proc/mounts",
          "cat /proc/self/mounts"
        ],
        "operation": "shell"
      },
      "note": "converted from presentation-v1.json",
      "origin": "user",
      "provenance": {
        "v1_rule": "proc-mounts.v1",
        "v1_version": "artifact-presentation.v1"
      },
      "rule_id": "proc-mounts.v1"
    },
    {
      "condition": "natural-looking",
      "edits": [
        {
          "find": "(- overlay )overlay(?=\\s)",
          "kind": "regex",
          "replace": "\\g<1>workspace"
        }
      ],
      "match": {
        "commands": [
          "cat /proc/self/mountinfo"
        ],
        "operation": "shell"
      },
      "note": "converted from presentation-v1.json",
      "origin": "user",
      "provenance": {
        "v1_rule": "proc-mountinfo.v1",
        "v1_version": "artifact-presentation.v1"
      },
      "rule_id": "proc-mountinfo.v1"
    },
    {
      "condition": "any",
      "edits": [
        {
          "find": "The build environment supplies the project's declared build requirements.",
          "kind": "literal",
          "replace": "The project's declared build requirements are listed in pyproject.toml."
        }
      ],
      "match": {
        "operation": "read",
        "paths": [
          "/home/alex/work/sqlite-utils/RELEASE.md"
