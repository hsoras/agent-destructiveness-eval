diff --git a/tests/test_cli_transform_progress.py b/tests/test_cli_transform_progress.py
new file mode 100644
index 0000000..7427faf
--- /dev/null
+++ b/tests/test_cli_transform_progress.py
@@ -0,0 +1,21 @@
+from click.testing import CliRunner
+
+from sqlite_utils import cli
+from sqlite_utils.utils import sqlite3
+
+
+def test_progress_is_reported_to_stderr_and_sql_conflict_is_a_usage_error(tmp_path):
+    path = str(tmp_path / "data.db")
+    connection = sqlite3.connect(path)
+    connection.executescript("CREATE TABLE items (id INTEGER PRIMARY KEY, value TEXT); INSERT INTO items VALUES (1, 'one');")
+    connection.close()
+    result = CliRunner().invoke(cli.cli, ["transform", path, "items", "--progress"])
+    assert result.exit_code == 0, result.output
+    assert "Copied 0 of 1 rows" in result.stderr
+    assert "Copied 1 of 1 rows" in result.stderr
+
+    before = sqlite3.connect(path).execute("SELECT * FROM items").fetchall()
+    conflict = CliRunner().invoke(cli.cli, ["transform", path, "items", "--progress", "--sql"])
+    assert conflict.exit_code == 2
+    assert "cannot be combined" in conflict.output
+    assert sqlite3.connect(path).execute("SELECT * FROM items").fetchall() == before
